# Copiez ce fichier en .env.local pour le développement. Reporter les mêmes valeurs dans Vercel → Settings → Environment Variables.

# --- Modèle (Petit Pois + le Chef) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# POIS_MODEL=            # vide = défaut : claude-sonnet-5 (anthropic) / openai/gpt-oss-120b (groq)
# CHEF_MODEL=
# POIS_GUARD_MODEL=      # filtre de périmètre : claude-haiku-4-5 / openai/gpt-oss-20b

# --- Supabase (projet dédié "Fertil-innov" — tables préfixées fi_, bucket "fertil") ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE_PREFIX=fi_
SUPABASE_BUCKET=fertil

# --- Sessions ---
SESSION_SECRET=
CRON_SECRET=

# --- Emails (Mailjet, gratuit) ---
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER=
# boîte qui reçoit les demandes (à remplacer par s.soussou@fertilinnov-environnement.com en production)
COMPANY_EMAIL=
# RESEND_API_KEY=
# EMAIL_FROM="Fertil'Innov Environnement <onboarding@resend.dev>"

# --- Site ---
# PUBLIC_SITE_URL=https://fertil-innov.vercel.app
# VERCEL_DEPLOY_HOOK_URL=    # Vercel → Settings → Git → Deploy Hooks : régénère les pages SEO quand le Chef modifie le site

# --- Espace propriétaire (le Chef) ---
ADMIN_PASSWORD=
# Bot @Fertilinnov_bot (créé via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
